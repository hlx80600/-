# ── 模型权重（体积大，单独管理）──────────────────────
*.pth
*.pt
# 忽略权重目录内容，但保留目录本身（.gitkeep 会追踪目录）
/weights/*.pth
/weights/*.pt

# ── Wheel 离线包 ─────────────────────────────────────
*.whl

# ── 运行时输出目录 ────────────────────────────────────
output/
test_output/

# ── Python ───────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
*.egg
dist/
build/
.eggs/
.installed.cfg
MANIFEST

# ── 虚拟环境 ─────────────────────────────────────────
.venv/
venv/
env/
.env

# ── IDE / 编辑器 ──────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── 系统文件 ─────────────────────────────────────────
.DS_Store
Thumbs.db

# ── 测试覆盖率 ────────────────────────────────────────
.coverage
htmlcov/
.pytest_cache/
